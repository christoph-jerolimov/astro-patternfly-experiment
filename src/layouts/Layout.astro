---
// PatternFly's base stylesheet. It ships a CSS reset plus all component styles
// and design tokens, so it has to be loaded once for the whole document.
import '@patternfly/react-core/dist/styles/base.css';

import { withBase } from '../site';
import {
  DARK_CLASS,
  MODIFIERS,
  MODIFIERS_STORAGE_KEY,
  STORAGE_KEY,
  THEME_CLASS_PREFIX,
} from '../theme';

const modifierIds = MODIFIERS.map((modifier) => modifier.id);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Astro + PatternFly',
  description = 'An Astro site using the PatternFly React component library.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    {/*
      Runs before the body is parsed so the page never paints in the wrong
      theme. It has to be inline and dependency-free for that reason, which is
      why it repeats the small amount of logic in src/theme.ts rather than
      importing it; the values it depends on are passed in from there.
    */}
    <script
      is:inline
      define:vars={{
        themeConfig: {
          storageKey: STORAGE_KEY,
          darkClass: DARK_CLASS,
          modifiersKey: MODIFIERS_STORAGE_KEY,
          modifierIds,
          prefix: THEME_CLASS_PREFIX,
        },
      }}
    >
      (() => {
        const { storageKey, darkClass, modifiersKey, modifierIds, prefix } = themeConfig;
        const root = document.documentElement;

        const stored = localStorage.getItem(storageKey);
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        root.classList.toggle(darkClass, theme === 'dark');

        // No stored choice means high contrast follows the OS. PatternFly ships
        // no prefers-contrast query of its own, so without this a reader who
        // asked for more contrast would not get it.
        const storedModifiers = localStorage.getItem(modifiersKey);
        const modifiers =
          storedModifiers === null
            ? matchMedia('(prefers-contrast: more)').matches
              ? ['high-contrast']
              : []
            : storedModifiers.split(',').filter((id) => modifierIds.includes(id));

        for (const id of modifierIds) {
          root.classList.toggle(prefix + id, modifiers.includes(id));
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Let the PatternFly page fill the viewport. */
  html,
  body {
    height: 100%;
  }
</style>
